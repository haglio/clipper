# The family's baseline block, byte-identical in every checkout that carries it,
# so what a routine editable install or test run drops is ignored in the repo
# that drops it. The eleven files were written independently and covered
# different subsets of the same artifacts, which left several trees dirty after
# a plain `pip install -e .` -- and a dirty tree here blocks every agent's merge.
# This repo's own entries go under the marker below, never in here.
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.hypothesis/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tmp-pytest-*/

# Windows shortcuts are machine-specific and embed the real install path.
*.lnk

# pCloud conflict copies (this dir syncs via pCloud). Never our files; an
# untracked one dirties main and blocks merges. '[' escaped to match literally.
*\[conflicted*

# --- clipper's own ---

# Where the app works: the clips it is given, the sessions it cuts, its state.
raw_clips/
sessions/
state/

# Named in this repo's pytest config as a directory not to walk into.
pytest-cache-files-*/

# Private overlays — real values live here and never get published; each has
# a committed *.example.* template documenting its shape.
/content.local.json

# The RIFE interpolator is fetched, not tracked: tools/fetch_rife.py puts it
# where clip_postprocess_transforms._find_rife_exe looks. The release zip is
# 432 MB and the script deletes it once the six files it wants are out.
/tools/rife-ncnn-vulkan-*/
/tools/rife-ncnn-vulkan-*.zip

# The example overlay's placeholder library_root, "C:/path/to/library-root", is a
# relative path on POSIX. ensure_runtime_dirs no longer derives library folders
# from it, so nothing here makes this any more; the line stays because a
# checkout running an older clipper still can, and what lands under it is media.
/C:/
