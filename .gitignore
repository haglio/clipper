raw_clips/
sessions/
state/

.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.tmp-pytest-*/
pytest-cache-files-*/

# Claude Code local config

# Private overlays — real values live here and never get published; each has
# a committed *.example.* template documenting its shape.
/content.local.json
/sanitize/*.local.txt

# Windows shortcuts are machine-specific and embed the real install path.
*.lnk

# The RIFE interpolator is fetched, not tracked: tools/fetch_rife.py puts it
# where clip_postprocess_transforms._find_rife_exe looks. The release zip is
# 432 MB and the script deletes it once the six files it wants are out.
/tools/rife-ncnn-vulkan-*/
/tools/rife-ncnn-vulkan-*.zip

# The example overlay's placeholder suite_root, "C:/path/to/suite-root", is a
# relative path on POSIX. ensure_runtime_dirs no longer derives library folders
# from it, so nothing here makes this any more; the line stays because a
# checkout running an older clipper still can, and what lands under it is media.
/C:/

# pCloud conflict copies (this dir syncs via pCloud). Never our files; an
# untracked one dirties main and blocks merges. '[' escaped to match literally.
*\[conflicted*
